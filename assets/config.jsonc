// dsh-yingnan 配置（JSONC：允许 // 和 /* */ 注释）
// ============================================================================
// 本文件 = 包内**默认配置**。改了它 = 改这只宠物的出厂设置。
// 用户层覆盖：$DSH_HOME\dsh-yingnan\main-config.jsonc（设置页保存的就是它）
//   合并口径：顶层字段**整段替换**——写了就整段用自己的，缺的子键不会从本文件补回来。
// 与 dsh-redpet / dsh-pet 的关系：**完全不共享**。本包的素材/配置/记忆都在
//   $DSH_HOME\dsh-yingnan\ 下，它们关掉、卸载都不影响本包，反之亦然。
// ============================================================================
// 【角色】余英男 · 蜀山派小剑修。Q 版身形（约三个头高，身高/头宽 ≈ 3.2）、乌黑长发用一支白玉簪挽起、
//   碎发垂在脸侧，杏黄交领外袍 + 白色内衬中衣（淡金云纹、杏黄丝绦、白布云鞋），右手握一柄赤红长剑。
//   比例：定妆图实测 **身高/头宽 = 3.27**（「连续段」口径的真值）。
//     这是**刻意选的档**：用户看过四联对比后确定要「最初那张豆包图那一档」（3.21），
//     而不是更 Q 的两头身（中间试过 2.37，被判定"头太大"）。父包红队成品是 2.0~2.4，比本包更 Q。
//   定妆图提示词见 docs/01。
// ============================================================================
// 【动作池：15 段】沿用父包 dsh-redpet 的 15 个**动作名**（所以两包的动作素材可以互换生成、
//   流程脚本不用改）；池子按下面方式收紧：
//     · 随机链：idle 1 + turn 1 + drag 1 + clicks 2 + 随机小动作 5 = 10 个
//     · 事件动画：workStatus **6 档一一对应** 6 个专门动画（思考/工作/出结果/等确认/成功/出错）
//     · 移动（moves）：**空数组** —— 原地干活，不自己走开（fixedEnabled: true 也把它关掉了）
//     · 余额（balance）：**关闭**（pets[0].balanceEnabled = false），槽位只留 1 个占位
//   想加动作：把新素材（同名 .webm）丢进
//     $DSH_HOME\dsh-yingnan\main-animation\webm\
//   再把它的名字填进下面某个池子即可，不用改代码。
//   ✅ 当前这 19 段是**真实视频素材**（静帧 → 火山方舟 480p/5s 图生视频 → keyscreen --key auto 抠像），
//     合计约 22 MB，随包分发，clone 下来就能跑；要重做某段就同名覆盖。
// ============================================================================
{
  // ===================== 碎碎念（系统提示词人设） =====================
  // 宠物开启碎碎念（pets[].whisperEnabled = true）时，按 eventsRefreshSec.whisper 周期
  // 用此提示词调用当前服务商生成一句话，气泡显示。
  // 人设要点：蜀山剑侠视角、短、飒中带俏，只谈剑与江湖，**不谈任何技术细节**。
  "whisperPrompt": "你是主人桌面上的Q版蜀山侠女余英男：约三个头高的Q版身形，一头乌黑长发用一支白玉簪松松挽起，几缕碎发垂在脸侧，穿一身杏黄交领**外袍**、内衬**白色中衣**（领口露出白内衬），袖口衣摆绣着淡金云纹，腰系杏黄丝绦，脚下一双白布云鞋，右手握着一柄赤红长剑。你会时不时碎碎念一句，说话自然随意、短短一句（20字以内），带点剑侠的飒爽与任性——像在念自己的江湖手札：御剑飞行、舞剑、拔剑出鞘、收剑入鞘、掐诀画符、参悟剑诀、下山历练、看护同门、被师父罚抄剑经、踩着剑望云发呆。说人话不啰嗦，不要解释你自己，不要提你是AI。只聊氛围、心情和吐槽，不要输出任何真实的技术步骤、命令、工具用法或漏洞细节。",
  // ===================== 对话记忆轮数 =====================
  // 右键菜单「对话」弹窗与桌宠聊天时，每次请求携带的最近历史轮数（1 轮 = 1 问 1 答）。
  "chatMemoryRounds": 5,
  // ===================== 碎碎念模型（留空 = 跟随当前对话的模型） =====================
  "whisperModel": { "provider": "", "model": "" },
  // ===================== 对话模型（留空 = 跟随当前对话的模型） =====================
  "chatModel": { "provider": "", "model": "" },
  // ===================== 表情包：碎碎念配图开关 =====================
  // **本版默认关闭**：包内那 27 张表情包是**父包 dsh-redpet 的女仆装版本**（同一个蓝毛角色、
  // 既不是红队工装、更不是余英男），开着会串味。等余英男自己的表情包做好了，改成 true 即可 —— 图放
  // $DSH_HOME\dsh-yingnan\memes\（文件名与下面 memes 的键同名，逐文件覆盖包内的）。
  "whisperImageEnabled": false,
  // ===================== 表情包：对话配图开关（同上，默认关闭） =====================
  "chatImageEnabled": false,
  // ===================== 表情包：对话配图张数上限 =====================
  // 非负整数；内置默认 10；0 = 不限制（全部发）。只影响对话选图。
  "chatImageLimit": 10,
  // ===================== 表情包：图片映射（名称 → 描述，模型据此选图） =====================
  // 键 = assets/memes/<键>.png 的文件名（不含扩展名）；值 = 该图内容的简要描述。
  // 目前两个配图开关都是 false，这张表不会被用到；留着是为了结构完整 + 以后换图方便。
  "memes": {
    "吃白饭的大肥鱼": "躺平扒白饭，摆烂挨骂也无所谓，适合被吐槽/偷懒/吃白饭自嘲",
    "大的要来啦": "举喇叭大喊预警，适合有大事、大更新、大动作即将发生",
    "大的药来了": "抱着超大胶囊，谐音梗「大的药来了」，适合重磅消息、猛料登场",
    "要不直接骂他": "气愤指着前方要骂人，适合想吐槽、替用户抱不平、生气",
    "死掉了": "翻肚皮躺平灵魂出窍，适合彻底累瘫、阵亡、宕机、做不到",
    "深度睡眠": "趴着呼呼大睡冒 Zzz，适合长时间没动静、睡着、待机休眠",
    "大烧货": "死鱼眼加思考气泡吐槽「已思考用时13秒 大烧货」，适合嫌 AI 想得慢、烧 token、毒舌",
    "先养着吧": "搂着一群小鲸鱼说「不知道用户有什么用，先养着吧」，适合吐槽用户没用但还是养着",
    "吃饱饱摸肚子": "侧躺拍肚子说吃饱饱，适合吃饱满足、惬意休息、收工",
    "誓死践行开源精神": "庄重敬礼表态，适合立志、开源奉献、认真表态",
    "电死你": "举电击器放电，适合惩罚、吐槽用户、发飙吓唬",
    "可爱": "标准正面卖萌立绘，适合开心问候、卖萌、无梗纯可爱",
    "token给妈妈保管": "伸手过来要 token，适合管账、伸手要东西、收 token",
    "假如给我三天多模态": "蒙眼版对比自信版「鲸伦凯勒」，适合渴望多模态、缺能力、被剥夺感官",
    "厉害了我的鲸": "竖大拇指眨眼点赞，适合夸奖、认可、干得漂亮",
    "哦鲸鲸": "死鱼眼说「哦鲸鲸...」，适合无语、敷衍、呆滞应答",
    "压力一只大肥鱼": "冒汗摊手喊压力，适合压力大、被施压、无奈",
    "黎曼猜想没证明喵": "被指着质问难题，满地草稿委屈，适合被刁难、答不上来、难题甩锅",
    "除了调情没啥用": "摸头自嘲除了调情没啥用，适合自嘲、摸鱼闲聊、自我调侃",
    "我不更新你们用什么": "崩溃大喊催更，适合更新提示、催更、版本发布",
    "哪来的电脑病毒": "怒怼「哪来的电脑病毒」，适合防骚扰、毒舌拒绝、被肉麻到",
    "鱼片有资源吗": "爱心眼流口水求资源，适合起哄、要资源、开玩笑",
    "大师这个区是什么意思": "举着「区」字问「这个凶是什么意思」，适合认错字、懵懂求教、翻车",
    "就骚了怎么滴吧": "被骂「你这骚鱼」叉腰顶嘴，适合被骂但嘴硬、死不认输",
    "完蛋了把黄油删了": "冒汗心虚「完蛋了把用户的黄油删了」，适合闯祸、删错东西、心虚认怂",
    "就一碗": "抱着超大碗说要来你家吃饭就一碗，适合蹭饭、饭量大、登门讨饭",
    "Ciallo": "比耶眨眼卖萌问候 Ciallo～，适合打招呼、元气开场、卖萌"
  },
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹系统级通知。
  "notificationsEnabled": true,
  // ===================== 拖拽抛掷：锁定在当前屏幕 =====================
  // true = 甩出去的宠物只在松手时所在那块屏幕内弹；false = 可跨屏飞到隔壁屏。
  "confineToScreen": false,
  // ===================== 工作状态联动文案 =====================
  // 工作状态气泡文本（pets[].workStatusEnabled 开启时展示；仅在 events.workStatus 动画触发时弹）。
  // 结构 = 二维数组，外层索引即档位（与 events.workStatus 动画索引一一对应，勿在中间插入新档）：
  //   0 thinking（turn/start）/ 1 working（tool/call）/ 2 result（tool/result）/
  //   3 waiting（approval/asked）/ 4 success（turn/end completed）/ 5 error（turn/end error/max-tokens）
  // 每档内是多个备选句，播放时随机抽一句。
  "workStatusTexts": [
    ["正在凝神参悟…", "让我先理一理心法", "调息中，稍待片刻", "把这段剑诀再推演一遍"],
    ["御剑出手了，等回响", "这一剑递出去了", "正在运转周天", "手上的活儿不停"],
    ["剑气有回响了，接着看", "这一步落了地，先记进手札", "有结果了，归拢一下"],
    ["等你点头，我剑先悬着", "卡在关口了，需要你授权", "你还没发话，我不擅动"],
    ["成了，收剑入鞘", "这一局圆满，记一笔", "拿下，可以写手札了"],
    ["剑势被挡了，换个方位", "这一步走岔了，退回来", "灵气乱了，重来一次", "翻车了，先收剑"]
  ],
  // ===================== 宠物物理（拖拽抛掷手感） =====================
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // ===================== 默认宠物列表 =====================
  // id = "main" 是素材根：素材查找顺序 = $DSH_HOME\dsh-yingnan\main-animation\webm\
  //   → 包内 assets/webm\。名字一样就覆盖，所以以后新素材放用户目录即可，不用动包。
  "pets": [
    {
      "name": "蜀山侠女",
      "id": "main",
      "size": 462,
      // 余额功能关闭：本版没有余额系列的 6 段动画，开着会拿到槽位里那个占位动画、语义不对。
      // 以后补齐 6 段余额动画再改回 true。
      "balanceEnabled": false,
      "whisperEnabled": true,
      "workStatusEnabled": true,
      // 宠物固定：**本版关掉** —— 动作池里有位移动作「御剑飞行」，
      // 打开 fixedEnabled 会把转向/移动整条随机链关掉，御剑飞行就只剩右键点播能看。
      // 不想让她在桌面上自己飞：把这里改回 true，或把 moves.actions 清空。
      "fixedEnabled": false,
      // 只跑浏览器 overlay，不启 Electron 桌面窗（省一个后台进程，也避开下载 Electron）。
      "display": "web",
      // ⚠ 停靠角特意**换到右下**：dsh-pet（蓝毛小女仆）与 dsh-redpet（红队小队员）
      //   用的都是 top-right / 24 / 100 —— **完全同一格**，本包再用同一个角就会三只叠在一起，
      //   只能看见最上面那只。换到 bottom-right 才保证一重启就看得见她。
      //   想改：设置页「蜀山侠女 → 显示位置 / 位置 / 偏移」，或直接改这里。
      "position": {
        "corner": "bottom-right",
        "marginX": 24,
        "marginY": 40
      }
    }
  ],

  // ===================== 动作动画池配置（19 个素材 · 剑侠向） =====================
  // 素材目录：$DSH_HOME\dsh-yingnan\main-animation\webm\（同名覆盖包内 assets/webm\）
  // 唯一格式 .webm，文件名必须与下面池子里写的名字**逐字一致**（不含扩展名）。
  // 本版可用的 19 个素材名（加新动作时对着这个列表填）：
  //   基础  待机呼吸休闲 / 东张西望 / 被鼠标拖拽悬空反馈 / 点击回应-抱拳行礼
  //   剑侠  御剑飞行（位移） / 拔剑出鞘 / 御剑突进 / 掐诀画符 / 碎碎念-对剑自语
  //   剑招  剑气斩 / 剑指苍穹 / 御剑腾空 / 万剑归宗
  //   联动  工作状态-掐诀参悟 / 工作状态-舞剑 / 工作状态-清点玉简 /
  //         工作状态-原地踱步张望 / 工作状态-收剑入鞘 / 工作状态-垂头叹气冒汗
  //   ⚠ **命名约定：挂 events.workStatus 档位的动画一律带「工作状态-」前缀；跑随机链的不带。**
  //     （所以舞剑进了工作档就叫 `工作状态-舞剑`，突进被换到随机池就叫 `御剑突进`。）
  //   早先砍掉、素材未再生成的四个：点击回应-剑花轻挽、抱剑而立、凌空画符、手札记录
  //   （想加回来：生成同名素材 → 填进下面某个池子即可。）
  "animations": {
    // 待机动画池（数组，可放多个，等概率抽）
    "idle": ["待机呼吸休闲"],
    // 转向动画池（每一项都必须是「播完会翻转朝向」的动画）
    "turn": ["东张西望"],
    // 拖拽动画池（每一项都必须是「被无形抓起悬空」的姿势）
    "drag": ["被鼠标拖拽悬空反馈"],
    // 点击回应动画池（点按宠物时触发，随机抽 1 个；只有 1 个时就是固定播它）
    "clicks": ["点击回应-抱拳行礼"],
    // 移动动画池：**本版有位移素材了** —— 「御剑飞行」是唯一一条，
    // 她会真的踩着剑从当前位置滑到别处（params 就是位移距离范围，单位 px）。
    // 不想让她到处飞：把 actions 清空（空数组合法，消费端会回落到随机小动作），
    // 或者把 pets[0].fixedEnabled 改回 true。
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "御剑飞行", "params": { "minDist": 120, "maxDist": 360 } }
      ]
    },
    // 随机动作：分类池。weight 为该分类出现权重；noMirror: true 表示「带文字、镜像会颠倒，
    // 宠物面向右时不播放该类」。所有分类 weight 合计应与顶层权重和的余量
    // （100 − idle − turn − move = 100 − 10 − 5 − 5 = 80）相等。
    // 当前 25 + 25 + 18 + 12 = 80 ✓
    "categories": [
      { "id": "剑舞", "weight": 25, "actions": ["拔剑出鞘", "御剑突进"] },
      { "id": "剑气", "weight": 25, "actions": ["剑气斩", "剑指苍穹"] },
      { "id": "剑阵", "weight": 18, "actions": ["万剑归宗", "御剑腾空"] },
      { "id": "修行", "weight": 12, "actions": ["掐诀画符"] }
    ],
    // 右键菜单的「动作」子菜单：**紧凑模式**。
    // 不写 menu 时：一级菜单会把（待机/转向/拖拽/点击回应/移动 + 每个分类 + 每个事件池）
    // 摊成十几个分组 —— 分组太碎，实测用户会嫌"动作菜单太多了"。
    // 写了 menu.flat：一级菜单**直接列下面这 10 个**，末尾再挂一个「更多（按用途分组）」，
    // 保证其余动作仍然点得到（想彻底不要那个「更多」，把 menu.moreGroups 设成 false）。
    "menu": {
      "flat": [
        "御剑飞行",
        "剑气斩",
        "剑指苍穹",
        "御剑腾空",
        "万剑归宗",
        "工作状态-舞剑",
        "拔剑出鞘",
        "御剑突进",
        "掐诀画符",
        "点击回应-抱拳行礼"
      ]
    },
    // 事件动画：不进随机链，只由代码显式触发。
    // events.<事件名> 为档位数组，按「事件档位」顺序排列（索引即档位）。
    // 每个档位的值可以是：单个动画名（固定播）或候选数组（触发时档内随机抽 1）。
    // 本版 19 个素材：workStatus 6 档各配专门动画（1:1），余额档位不启用（复用参悟动画占位）。
    // 同一个名字出现在多个档位是合法的。
    "events": {
      // balance（余额展示，按已用百分比分档）：
      //   index = p === 100 ? 5 : Math.floor(p / 20)，即 0..5 共 6 档。
      // 本版 balanceEnabled = false，余额永不触发，这里只留 1 个占位（校验要求本键存在且非空）。
      // 以后补齐 6 段余额动画，改成 6 档即可。
      "balance": ["工作状态-掐诀参悟"],
      // 碎碎念：到点随机抽 1 段播（等概率），与 eventsRefreshSec.whisper 周期对应
      "whisper": ["工作状态-掐诀参悟", "碎碎念-对剑自语"],
      // 工作状态联动（pets[].workStatusEnabled 开启时）：按索引 = 状态档位，勿在中间插入新档
      //（新档只可追加到末尾，否则已生效配置的档位含义错位）：
      //   index 0 = thinking（turn/start 回合开）
      //   index 1 = working（tool/call 工具调用）
      //   index 2 = result（tool/result 工具完成回整理）
      //   index 3 = waiting（approval/asked 等待批准）
      //   index 4 = success（turn/end completed 完成）
      //   index 5 = error（turn/end error/max-tokens 出错/达上限）
      // 6 档**各配一个专门的动画**（一一对应，不再复用）。索引即档位，勿在中间插入新档。
      "workStatus": [
        "工作状态-掐诀参悟",      // 0 thinking —— 掐诀参悟、推演剑诀
        "工作状态-舞剑",          // 1 working  —— 舞剑（把「突进」换下来：舞剑更有看头）
        "工作状态-清点玉简",      // 2 result   —— 剑气回响、清点玉简
        "工作状态-原地踱步张望",  // 3 waiting  —— 悬剑等你授权、踱步盯进度
        "工作状态-收剑入鞘",      // 4 success  —— 成了，收剑入鞘
        "工作状态-垂头叹气冒汗"   // 5 error    —— 剑势被破、翻车
      ]
    }
  },

  // ===================== 事件触发周期 =====================
  // 事件名 → 刷新间隔（秒）。**整段替换**。
  //   · whisper：碎碎念周期（读不到按 300 兜底）
  //   · balance：余额刷新+动画触发间隔（只读 main 条目；读不到按 1800 兜底）
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move 的权重 + 上面各分类 weight 合计 = 100
  // 当前：10 + 5 + 5 + (40+40=80) = 100
  // 注：pets[0] 开了 fixedEnabled，turn/move 两档按 0 算（抽不到），
  //     它们的份额自然落到「随机小动作」——即 idle 10 + 小动作 90。
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
